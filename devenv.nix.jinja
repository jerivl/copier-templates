{ pkgs, lib, config, inputs, ... }:
let
  {%- if 'python' in languages or literate == 'True' %}
  buildInputs = with pkgs; [
    stdenv.cc.cc
    libuv
    zlib
  ];
  {%- endif %}
in 
{
  env.GREET = "{{project_name}}";

  packages = with pkgs; [
    git
    yq
    {%- if vcs == "jj" %}
    jujutsu
    {%- endif %}
    {%- if ide == "vscode" %}
    (vscode.fhsWithPackages (ps: with ps; [ rustup zlib openssl.dev pkg-config ]))
    {%- endif %}
  ];

  {# Python should build C and has support for CUDA through: #}
  {# https://github.com/clementpoiret/nix-python-devenv #}
  {%- if 'python' in languages or literate == 'True' %}
  env = {
    LD_LIBRARY_PATH = "${lib.makeLibraryPath buildInputs}";
  };

  languages.python = {
    enable = true;
    uv = {
      enable = true;
      sync = {
        enable = true;
      };
    };
  };

  {%- endif %}

  
  scripts.hello.exec = ''
    echo Hello from $GREET
  '';

  scripts.check-git.exec = ''
    var="$(yq '.vcs' {{_copier_conf.answers_file}})" 
    if [ ! -d ".git" ]; then
      if [[ $var =~ "jj" ]]; then
        jj git init --colocate
      else
        git init -b main
      fi
    fi
  '';
  {%- if 'python' in languages or literate == 'True' %}
  scripts.python-setup.exec = ''
    {%- if literate == 'True' %}
    if [ ! -d ".git" ]; then
      entangled tangle --force >/dev/null 2>&1
    fi
    {% endif %}
    uv run python hello.py
  '';
  {% endif %}

  # https://devenv.sh/basics/
  enterShell = ''
    {%- if 'python' in languages or literate == 'True' %}
    . .devenv/state/venv/bin/activate
    python-setup # Tangles if the git repository if it doesn't already exist
    {%- endif %}
    hello
    check-git  # Creates git repository depending on if it already exists
  '';

  enterTest = ''
    echo "Running tests"
    git --version | grep --color=auto "${pkgs.git.version}"
  '';

  # https://devenv.sh/git-hooks/
  # git-hooks.hooks.shellcheck.enable = true;

  # See full reference at https://devenv.sh/reference/options/
}
