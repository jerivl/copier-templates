{ pkgs, lib, config, inputs, ... }:
let
  {%- if python in languages or literate %}
  buildInputs = with pkgs; [
    stdenv.cc.cc
    libuv
    zlib
  ];
  {%- endif %}
in 
{
  env.GREET = "{{project_name}}";

  packages = with pkgs; [
    git
    yq
    {%- if vcs == "jj" %}
    jujutsu
    {%- endif %}
  ];

  {# Python should build C and has support for CUDA through: #}
  {# https://github.com/clementpoiret/nix-python-devenv #}
  {%- if python in languages or literate %}
  env = {
    LD_LIBRARY_PATH = "${lib.makeLibraryPath buildInputs}";
  };

  languages.python = {
    enable = true;
    uv = {
      enable = true;
      sync = {
        enable = true;
      };
    };
  };

  {%- endif %}

  
  scripts.hello.exec = ''
    echo hello from $GREET
    {%- if python or literate %}
    uv run python hello.py
    {%- endif%} 
  '';

  scripts.check-git.exec = ''
    var="$(yq '.vcs' {{_copier_conf.answers_file}})" 
    if [ ! -d ".git" ]; then
      if [[ $var =~ "jj" ]]; then
        jj git init --colocate
      else
        git init -b main
      fi
    fi
  '';

  # https://devenv.sh/basics/
  enterShell = ''
    {%- if python or literate %}
    . .devenv/state/venv/bin/activate
    {%- endif%} 
    hello         # Run scripts directly
    check-git
  '';

  enterTest = ''
    echo "Running tests"
    git --version | grep --color=auto "${pkgs.git.version}"
  '';

  # https://devenv.sh/git-hooks/
  # git-hooks.hooks.shellcheck.enable = true;

  # See full reference at https://devenv.sh/reference/options/
}
